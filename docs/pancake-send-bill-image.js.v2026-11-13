// Same read-only-capable anon key already embedded in bridge-server.js for the Telegram summary
// query (RLS is off on these tables, same key the Marketing Studio SPA itself uses client-side).
const SUPABASE_ANON_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InN3cmlqcGtrdWZhcmRkc3lxaHJoIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODI5MDQ4ODYsImV4cCI6MjA5ODQ4MDg4Nn0.GoGsR4Z4u4UiCJ03-jZkJAgjJtjD8J4MosiBh4cpths';
const MS_BOT_TOKEN = '6daa795e5d328a784713b941a6007d597c8b0d5f791c94e7188ee2c0c9859656'; // [2026-11-05 security] session token header x-ms-token, read by DB policy ms_ok()

function sbGet(pathAndQuery) {
  return new Promise((resolve, reject) => {
    https.get({
      hostname: SUPABASE_HOST, path: pathAndQuery,
      headers: { apikey: SUPABASE_ANON_KEY, 'x-ms-token': MS_BOT_TOKEN, Authorization: `Bearer ${SUPABASE_ANON_KEY}` },
    }, (res) => {
      let body = '';
      res.on('data', (d) => (body += d));
      res.on('end', () => { try { resolve(JSON.parse(body)); } catch (e) { reject(e); } });
    }).on('error', reject);
  });
}

// [added 2026-09-28, controlled-trial rollout] PATCH courier_bill_import_pages after a live send
// -- this was the missing piece flagged before wiring this into ANY repeated/automated trigger:
// without it, send_status stayed "ready_to_send" forever, so a second run (manual retrigger, or
// later a 30s auto-poll) would pick the SAME row again and re-send the SAME image to the SAME
// customer with no limit. Uses the anon key (RLS off on this table, same as sbGet/the rest of
// this file) -- fine for this internal server-side script, matches the trust level already used
// everywhere else in it.
function sbPatch(pathAndQuery, bodyObj) {
  return new Promise((resolve, reject) => {
    const bodyStr = JSON.stringify(bodyObj);
    const req = https.request({
      hostname: SUPABASE_HOST, path: pathAndQuery, method: 'PATCH',
      headers: {
        apikey: SUPABASE_ANON_KEY, 'x-ms-token': MS_BOT_TOKEN, Authorization: `Bearer ${SUPABASE_ANON_KEY}`,
        'Content-Type': 'application/json', 'Content-Length': Buffer.byteLength(bodyStr),
        Prefer: 'return=minimal',
      },
    }, (res) => {
      let body = '';
      res.on('data', (d) => (body += d));
      res.on('end', () => resolve({ statusCode: res.statusCode, body }));
    });
    req.on('error', reject);
    req.write(bodyStr);
    req.end();
  });
}

// [new 2026-09-29c, duplicate-send fix] Same as sbPatch but with Prefer: return=representation,
// so the caller can tell an ATOMIC CLAIM apart from a no-op: PostgREST applies the URL's WHERE
// filter (including our own send_status re-check) server-side as part of the single UPDATE
// statement, so if two runs race for the same row, only the one whose filter still matched when
// the database actually executed the write gets a row back -- the loser gets an empty array, not
// an error, and must never treat that as "nothing to claim, we're done" (see AUTO_PICKED_ROW below
// for why that distinction matters). This is the same compare-and-swap trick a "SELECT ... FOR
// UPDATE" row lock gives you, but expressed as a plain PostgREST PATCH since this script has no
// direct DB connection.
function sbPatchClaim(pathAndQuery, bodyObj) {
  return new Promise((resolve, reject) => {
    const bodyStr = JSON.stringify(bodyObj);
    const req = https.request({
      hostname: SUPABASE_HOST, path: pathAndQuery, method: 'PATCH',
      headers: {
        apikey: SUPABASE_ANON_KEY, 'x-ms-token': MS_BOT_TOKEN, Authorization: `Bearer ${SUPABASE_ANON_KEY}`,
        'Content-Type': 'application/json', 'Content-Length': Buffer.byteLength(bodyStr),
        Prefer: 'return=representation',
      },
    }, (res) => {
      let body = '';
      res.on('data', (d) => (body += d));
      res.on('end', () => { try { resolve(JSON.parse(body)); } catch (e) { reject(e); } });
    });
    req.on('error', reject);
    req.write(bodyStr);
    req.end();
  });
}

