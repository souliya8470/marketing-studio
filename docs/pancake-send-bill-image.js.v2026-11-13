// [new 2026-09-28] "Send the REAL bill image via Pancake, like an admin attaching it by hand"
// (Tar's request, replacing the text-link-only send that send-courier-bill-pancake's API route is
// stuck with -- confirmed in that function's own comments that Pancake's reply_inbox API cannot
// embed a real image). This drives the real Pancake web UI instead, the same technique already
// proven for anousith-arrival-tag.js's text sends -- but attaches a real file instead of typing.
//
// Found via pancake-attach-diag.js (read-only DOM inspection, 2026-09-28): the real attach target
// is a single hidden file input, `#uploadFileInput` (multiple, accept includes .gif/.pdf/.docx/
// etc but not explicitly image/jpg/png -- that accept list only gates the OS file-picker dialog,
// which Playwright's setInputFiles() bypasses entirely; confirmed working live 2026-09-28 -- a
// .png attaches fine and shows a "FILE" card in the composer).
//
// [update 2026-09-28] mode=live send button: confirmed via a real preview run (row
// cbp_1790575601386mrubu, test override phone) that after attaching, a toolbar row appears BELOW
// the composer (not within +/-250px of the composer's PRE-attach top, which is why the old
// afterAttach scan never saw it) with emoji/image/gif icons plus a blue paper-plane SEND button at
// the far right. This version scans a much wider band (composer top -400px to bottom +400px) to
// reliably reach that shifted-down row, tags every visible button candidate with a data attribute,
// and picks the send button using the "new-reply-box-btn" className heuristic (see pickSendCandidate).
//
// [update 2026-09-28, round 2] First real live send worked (confirmed by Tar -- the image did
// arrive), but Tar pointed out via screenshot that the file-input attach method shows a generic
// "FILE" card in Pancake's composer, not a real image thumbnail -- likely because that upload path
// treats it as a document attachment rather than an inline photo, which may still read as
// "something to download" to a wary customer. Tar's own suggestion: put the image on the Windows
// clipboard and paste it (Ctrl+V) into the composer instead, the same way a human admin would --
// most chat UIs treat a pasted image specially and render a real inline thumbnail. This version
// adds that as a selectable method (see `useClipboard` below) alongside the original file-input
// method, so both can be compared before deciding which one to keep.
//
// SAFETY DESIGN (per Tar: "ອໍເດີທີ່ຈະສົ່ງແທ້ ຂ້ອຍຈະບອກຫຼັງເຈົ້າຂຽນລະບົບແລ້ວ" -- he picks the real
// order to test with once this is built):
//  - Takes a courier_bill_import_pages row id, not a phone number, so no PII ever travels through
//    bridge-server.js's URL querystring (the phone is looked up here, server-side, from Supabase).
//  - mode="preview" (default): searches the customer, opens the conversation, attaches the real
//    image file into #uploadFileInput, screenshots the result, dumps every candidate send-button
//    element it can see, and STOPS -- does not click any send control and does not press Enter.
//    Nothing reaches the customer in this mode.
//  - mode="live": does everything preview mode does, then clicks the button it identifies as the
//    real send control (see heuristic above), waits, screenshots the result, and reports what it
//    clicked (so a human can verify from the screenshot that a real send happened) -- but does NOT
//    yet mark the Supabase row as sent (left as a manual/explicit next step until a live send has
//    been visually confirmed at least once).
//  - Never run mode=live against a real customer until a live test run (override phone) has been
//    visually confirmed by Tar.
(function(){try{var f=require('fs'),L='C:\\n8n-data\\script-output-log.txt',w=function(k,a){try{f.appendFileSync(L,'['+new Date().toISOString()+'] pancake-send-bill-image '+(process.argv[2]||'')+' '+k+' '+a.map(String).join(' ')+'\n');}catch(e){}},ol=console.log,oe=console.error;console.log=function(){w('OUT',[].slice.call(arguments));ol.apply(console,arguments);};console.error=function(){w('ERR',[].slice.call(arguments));oe.apply(console,arguments);};}catch(e){}})();
const { chromium } = require('playwright-core');
const https = require('https');
const http = require('http');
const fs = require('fs');
const path = require('path');
const { execFileSync } = require('child_process');

// [new 2026-09-30, Tar's "jimp ກວດເນື້ອຫາຮູບ"] Content check: after the trailing-src check proves SOME new
// image appeared in the chat, also prove it is THE bill we meant to send (compare the new chat image
// with the local bill file via bill-image-match.js / jimp). LOG-ONLY by default: the similarity is
// logged as CONTENT_VERIFY on every send but never changes the outcome, until Tar has seen real
// scores and turned enforcement on with env BILL_IMAGE_MATCH_ENFORCE=1 (threshold: env
// BILL_IMAGE_MATCH_THRESHOLD, default 0.97 -- measured: same bill recompressed ~0.99, different
// bills <=0.93). Every failure inside (jimp missing, download failed...) is swallowed into the log
// and NEVER blocks or crashes a send.
let compareImages = null;
try { compareImages = require('./bill-image-match.js').compareImages; } catch (e) { console.log('CONTENT_VERIFY_UNAVAILABLE ' + String(e && e.message || e)); }
const BILL_IMAGE_MATCH_ENFORCE = process.env.BILL_IMAGE_MATCH_ENFORCE === '1';
const BILL_IMAGE_MATCH_THRESHOLD = parseFloat(process.env.BILL_IMAGE_MATCH_THRESHOLD || '0.97');
async function verifyNewImageContent(page, newSrcs, localImagePath) {
  if (!compareImages) return { ok: false, error: 'bill-image-match.js not loaded' };
  try {
    const localBuf = fs.readFileSync(localImagePath);
    let best = null;
    for (const src of (newSrcs || []).slice(0, 3)) {
      try {
        const res = await page.request.get(src, { timeout: 20000 });
        if (!res.ok()) { best = best || { ok: false, error: 'download status ' + res.status() }; continue; }
        const cmp = await compareImages(localBuf, await res.body());
        if (cmp.ok && (!best || !best.ok || cmp.similarity > best.similarity)) best = cmp;
        else if (!cmp.ok && !best) best = cmp;
      } catch (e) { best = best || { ok: false, error: String(e && e.message || e) }; }
    }
    return best || { ok: false, error: 'no candidate images' };
  } catch (e) { return { ok: false, error: String(e && e.message || e) }; }
}

// [new 2026-09-29, per Tar: "ກວດ Chrome ພ້ອມກ່ອນລອງສົ່ງທຸກຄັ້ງ"] Cheap pre-flight check against
// Chrome's own CDP endpoint (the same one chromium.connectOverCDP hits later) -- lets the script
// fail fast, BEFORE picking or touching any DB row, with a clearly distinguishable
// stage:"chrome_not_ready" the bridge-server.js circuit breaker can recognize, instead of the
// generic ECONNREFUSED that used to surface deep inside connectOverCDP after a row was already
// auto-picked.
function checkChromeReady(port, timeoutMs = 3000) {
  return new Promise((resolve) => {
    const req = http.get({ hostname: 'localhost', port, path: '/json/version', timeout: timeoutMs }, (res) => {
      let body = '';
      res.on('data', (d) => { body += d; });
      res.on('end', () => resolve({ ready: res.statusCode === 200, statusCode: res.statusCode }));
    });
    req.on('error', (e) => resolve({ ready: false, error: e.message }));
    req.on('timeout', () => { req.destroy(); resolve({ ready: false, error: 'timeout' }); });
  });
}

// Puts a local image file onto the Windows clipboard as a real image (not a file-path text
// string), the same as a human doing "copy image" -- so a subsequent Ctrl+V in the browser pastes
// an actual picture into the chat composer, same as Tar suggested.
function setClipboardImage(imagePath) {
  const psScript = [
    'Add-Type -AssemblyName System.Windows.Forms',
    'Add-Type -AssemblyName System.Drawing',
    `$img = [System.Drawing.Image]::FromFile('${imagePath.replace(/'/g, "''")}')`,
    '[System.Windows.Forms.Clipboard]::SetImage($img)',
  ].join('; ');
  execFileSync('powershell.exe', ['-NoProfile', '-STA', '-Command', psScript], { timeout: 15000 });
}

